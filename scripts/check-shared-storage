#!/usr/bin/env bash
# Run after starting development Compose, with host PHP 8.5 on PATH.
set -euo pipefail

base_url="https://localhost:${HTTPS_PORT:-443}"
ca_file=''
check_migration=false
while [[ $# -gt 0 ]]; do
    case "$1" in
        --url|--ca-file)
            if [[ $# -lt 2 || -z $2 ]]; then
                printf '%s requires a value.\n' "$1" >&2
                exit 2
            fi
            if [[ $1 == --url ]]; then base_url=${2%/}; else ca_file=$2; fi
            shift 2
            ;;
        --check-migration) check_migration=true; shift ;;
        --help)
            cat <<'HELP'
Usage: scripts/check-shared-storage [--url URL] [--ca-file PATH] [--check-migration]

Check shared writes, ownership, cache isolation, and native Mate against a running
development stack. Requires PHP 8.5, Composer, Python 3, curl, and Docker Compose.
--url defaults to https://localhost:${HTTPS_PORT:-443}.
--ca-file defaults to copying Caddy's local CA from the running container.
--check-migration also checks the legacy-ownership marker seeded by CI.
This check warms/clears the native dev cache and creates temporary probe files.
HELP
            exit 0
            ;;
        *) printf 'Unknown argument: %s (see --help).\n' "$1" >&2; exit 2 ;;
    esac
done

# Resolve caller-relative certificate paths before changing directory.
if [[ -n $ca_file ]]; then ca_file=$(realpath "$ca_file"); fi
cd "$(dirname "${BASH_SOURCE[0]}")/.."

test "$(docker compose exec -T php id -u)" = "$(id -u)"
test "$(docker compose exec -T php id -g)" = "$(id -g)"
test "$(docker compose exec -T tailwind id -u)" = "$(id -u)"
if $check_migration; then
    test "$(docker compose exec -T php cat /data/caddy/ownership-regression)" = retained
fi

scratch_dir=$(mktemp -d var/shared-storage.XXXXXX)
trap 'rm -rf "$scratch_dir"' EXIT
if [[ -z $ca_file ]]; then
    ca_file="$scratch_dir/caddy-root.crt"
    docker compose cp php:/data/caddy/pki/authorities/local/root.crt "$ca_file"
fi
printf host > "$scratch_dir/roundtrip"
docker compose exec -T php sh -euc '
    test "$(cat "$1/roundtrip")" = host
    printf container >> "$1/roundtrip"
    printf container > "$1/container-created"
' sh "$scratch_dir"
test "$(cat "$scratch_dir/roundtrip")" = hostcontainer
test "$(stat -c %u "$scratch_dir/container-created")" = "$(id -u)"
printf host >> "$scratch_dir/container-created"
rm "$scratch_dir/container-created"
test -s var/tailwind/app.built.css

# Warm native metadata without loading the running container's compiled cache.
APP_ENV=dev php bin/console cache:warmup
test -f var/cache/host/dev/App_KernelDevDebugContainer.xml
test -f var/cache/docker/dev/App_KernelDevDebugContainer.xml
composer check-platform-reqs
vendor/bin/mate tools:call server-info --format=json > "$scratch_dir/runtime.json"
for context in host docker; do
    vendor/bin/mate tools:call symfony-services --context="$context" --query='App\Twig\Components\ArchivePreview' --limit=5 --format=json > "$scratch_dir/$context.json"
done

# The native Mate process must read a profile generated by the container's HTTP request.
curl --cacert "$ca_file" --fail --silent --show-error \
    --dump-header "$scratch_dir/headers" --output /dev/null "$base_url/foundation"
token=$(awk 'tolower($1) == "x-debug-token:" {gsub("\r", "", $2); print $2}' "$scratch_dir/headers")
test -n "$token"
# Symfony writes the profile during request termination, after sending the response.
for attempt in {1..20}; do
    if vendor/bin/mate tools:call symfony-profiler-get --token="$token" --format=json > "$scratch_dir/profile.json" 2> "$scratch_dir/profile-error"; then
        break
    fi
    if [[ $attempt == 20 ]]; then cat "$scratch_dir/profile-error" >&2; exit 1; fi
    sleep 0.2
done

python3 - "$scratch_dir" "$token" <<'PY'
import json
import sys
from pathlib import Path

root = Path(sys.argv[1])
runtime = json.loads((root / 'runtime.json').read_text())
assert runtime['php_version'].startswith('8.5.')
for context in ('host', 'docker'):
    result = json.loads((root / f'{context}.json').read_text())
    assert r'App\Twig\Components\ArchivePreview' in result['untrusted_data'][context]['services'], result
profile = json.loads((root / 'profile.json').read_text())
assert profile['untrusted_data']['token'] == sys.argv[2], profile
print('Native Mate reads both service contexts and the container-generated profile.')
PY

# A native cache clear must leave Docker's compiled container and shared profiles intact.
printf keep > var/cache/docker/dev/host-clear-regression
APP_ENV=dev php bin/console cache:clear
test "$(cat var/cache/docker/dev/host-clear-regression)" = keep
vendor/bin/mate tools:call symfony-profiler-get --token="$token" --format=json > "$scratch_dir/profile-after-clear.json"
rm var/cache/docker/dev/host-clear-regression
printf 'Shared storage, ownership, cache isolation and native Mate checks passed.\n'

{% extends 'base.html.twig' %}
{% block title %}{{ username }} · Chess Dog{% endblock %}
{% block body %}
<div class="page-width archive-page">
    <a href="{{ path('app_players') }}" class="text-link">Find another player</a>
    <p class="eyebrow">{{ provider == 'chess.com' ? 'Chess.com' : 'Lichess' }}</p>
    <h1>{{ profile.display_username|default(username) }}</h1>
    {% for message in app.flashes('archive_error') %}<p role="alert">{{ message }}</p>{% endfor %}
    {% if error %}<p role="status">{{ error }}</p>{% endif %}
    {% if profile %}
        <dl class="archive-facts">
            {% if profile.title|default(null) %}<div><dt>Title</dt><dd>{{ profile.title }}</dd></div>{% endif %}
            {% if profile.profile.real_name|default(null) %}<div><dt>Name</dt><dd>{{ profile.profile.real_name }}</dd></div>{% endif %}
            {% if profile.profile.location|default(null) %}<div><dt>Location</dt><dd>{{ profile.profile.location }}</dd></div>{% endif %}
            {% if profile.profile.created_at|default(null) %}<div><dt>Joined</dt><dd>{{ profile.profile.created_at|date('Y-m-d', 'UTC') }}</dd></div>{% endif %}
            {% if profile.profile.last_seen_at|default(null) %}<div><dt>Last active</dt><dd>{{ profile.profile.last_seen_at|date('Y-m-d H:i', 'UTC') }} UTC</dd></div>{% endif %}
            {% if profile.profile.observed_at|default(null) %}<div><dt>Profile captured</dt><dd>{{ profile.profile.observed_at|date('Y-m-d H:i', 'UTC') }} UTC</dd></div>{% endif %}
        </dl>
    {% endif %}
    <section aria-labelledby="collection-heading" class="overview-card">
        <h2 id="collection-heading">Collect games</h2>
        <p>Choose a period to add games to your archive. Stored games are reused. End date is exclusive; dates use UTC.</p>
        <form action="{{ path('app_player_collect', {provider, username}) }}" method="post" class="preview-fields">
            <input type="hidden" name="_token" value="{{ csrf_token('collect:' ~ provider ~ ':' ~ username) }}">
            <input type="hidden" name="submission_key" value="{{ submission_key }}">
            <div class="preview-field"><label for="since" class="field-label">From</label><input id="since" name="since" type="date" value="{{ since }}" required class="preview-select"></div>
            <div class="preview-field"><label for="until" class="field-label">Until</label><input id="until" name="until" type="date" value="{{ until }}" required class="preview-select"></div>
            <button type="submit" class="primary-link">Collect games</button>
        </form>
        <p class="field-help">Up to 1,000 games in a period of one year. Collection continues in the background.</p>
    </section>
    <section aria-labelledby="games-heading">
        <h2 id="games-heading">Stored games</h2>
        {% if games.items|default([]) is empty %}<p>No games to show for this player.</p>{% else %}
        <div class="archive-table"><table><thead><tr><th>White</th><th>Black</th><th>Result</th><th>Played</th><th>Time control</th></tr></thead><tbody>
            {% for game in games.items %}<tr><td><a href="{{ path('app_archive_game', {id: game.id}) }}">{{ game.white_username|default(game.white|default('Unknown')) }}</a></td><td>{{ game.black_username|default(game.black|default('Unknown')) }}</td><td>{{ game.result|default(game.outcome|default('Unknown')) }}</td><td>{{ game.ended_at|default(game.started_at|default(null)) ? game.ended_at|default(game.started_at)|date('Y-m-d', 'UTC') : 'Unknown' }}</td><td>{{ game.time_control|default(game.time_control_raw|default('Unknown')) }}</td></tr>{% endfor %}
        </tbody></table></div>
        {% endif %}
        {% if games.next_cursor|default(null) is not null %}<a class="text-link" href="{{ path('app_player', {provider, username, after: games.next_cursor}) }}">Next games →</a>{% endif %}
    </section>
</div>
{% endblock %}

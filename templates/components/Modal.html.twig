{%- props
    ## boolean Whether the modal is open on initial render.
    open = false,
    ## string Unique identifier used to generate internal Modal IDs.
    id
-%}

{%- set _modal_id = 'modal-' ~ id -%}
{%- set _modal_title_id = _modal_id ~ '-title' -%}
<div
    data-flowbite-modal-open-value="{{ open ? 'true' : 'false' }}"
    aria-labelledby="{{ _modal_title_id }}"
    {{ attributes.defaults({
        'data-controller': 'flowbite-modal',
        'data-action': 'turbo:before-cache@document->flowbite-modal#beforeCache'|html_attr_type('sst'),
    }) }}
>
    {## The modal structure, typically includes `Modal:Trigger` and `Modal:Content`. -#}
    {% block content %}{% endblock %}
</div>
